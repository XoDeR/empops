# Optional environment overrides for config/app.*.yaml.
# Copy to .env and source it, or export these before running cmd/api.

EMPOPS_CONFIG=config/app.dev.yaml
EMPOPS_MODULES_CONFIG=config/modules.yaml
EMPOPS_MIGRATIONS_DIR=migrations

EMPOPS_JWT_SECRET=dev-secret-change-me
EMPOPS_HTTP_PORT=8080

# Optional - the Step 0 stub auth flow works without Postgres.
EMPOPS_DB_DSN=postgres://empops:empops@localhost:5433/empops_go?sslmode=disable

ENABLE_SIGNUPS=true
DEMO_MODE=false
ENABLE_PAID_PLAN=false
