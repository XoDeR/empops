APP_NAME=EmpOps
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=empops_laravel
DB_USERNAME=empops
DB_PASSWORD=empops

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

JWT_SECRET=empops-step0-dev-secret-change-me
JWT_ISSUER=empops
JWT_AUDIENCE=empops-web
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@empops.local"
MAIL_FROM_NAME="${APP_NAME}"
